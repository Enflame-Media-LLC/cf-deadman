{
  "name": "cf-deadman",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint apps/backend apps/web",
    "build": "vite build",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "smoke": "node scripts/smoke.mjs"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "D1 stores the one-owner switch, schedules, check-ins, and action runs."
      },
      "ACTIONS": {
        "description": "Queue for durable action execution."
      },
      "SETUP_SECRET": {
        "description": "Generate a unique random value with `openssl rand -hex 32`; required only to claim the first owner."
      },
      "BETTER_AUTH_SECRET": {
        "description": "Generate a different random value with `openssl rand -hex 32` for authentication signing."
      },
      "DATA_ENCRYPTION_KEY": {
        "description": "Generate a third random value with `openssl rand -hex 32` to encrypt the separate check-in TOTP secret."
      }
    }
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.6",
    "@hono/zod-openapi": "^1.6.3",
    "@lucide/vue": "^1.48.0",
    "@vueuse/core": "^15.0.0",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.9",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "oxlint": "^1.85.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.142.0"
  }
}
