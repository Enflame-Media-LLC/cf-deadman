{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "@/*": ["./apps/web/src/*"] },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/vitest-plugin/types", "vitest/globals"]
  },
  "include": ["apps/**/*.ts", "apps/**/*.vue", "worker-configuration.d.ts", "vite.config.ts", "vitest.config.ts"]
}
